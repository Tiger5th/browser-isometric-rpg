{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content:common",
  "title": "content 共享定义",
  "$defs": {
    "regionId": { "type": "string", "pattern": "^region:[a-z0-9_]+$" },
    "npcId": { "type": "string", "pattern": "^npc:[a-z0-9_]+$" },
    "enemyTemplateId": { "type": "string", "pattern": "^enemy_template:[a-z0-9_]+$" },
    "enemyId": { "type": "string", "pattern": "^enemy:[a-z0-9_]+$" },
    "itemId": { "type": "string", "pattern": "^item:[a-z0-9_]+$" },
    "questId": { "type": "string", "pattern": "^quest:[a-z0-9_]+$" },
    "objectiveId": { "type": "string", "pattern": "^objective:[a-z0-9_]+$" },
    "entityId": { "type": "string", "pattern": "^entity:[a-z0-9_]+$" },
    "dialogueId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "characterPaletteId": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
    "levelCurveId": { "type": "string", "pattern": "^level_curve:[a-z0-9_]+$" },
    "hexColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "safeZoneId": { "type": "string", "pattern": "^zone:[a-z0-9_]+$" },
    "price": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "priceTable": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "urn:content:common#/$defs/itemId" },
      "additionalProperties": { "$ref": "urn:content:common#/$defs/price" }
    },
    "dwellMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
    "templateId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$" },
    "aiProfileId": { "type": "string", "pattern": "^ai:[a-z0-9_]+$" },
    "aiProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["chaser", "windup-charge", "ranged-kite"] },
        "windupMs": { "type": "number", "exclusiveMinimum": 0 },
        "chargeSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "chargeDistance": { "type": "number", "exclusiveMinimum": 0 },
        "recoveryMs": { "type": "number", "minimum": 0 },
        "triggerRange": { "type": "number", "minimum": 0 },
        "hitRadius": { "type": "number", "exclusiveMinimum": 0 },
        "preferredRange": { "type": "number", "exclusiveMinimum": 0 },
        "retreatRange": { "type": "number", "minimum": 0 },
        "fireIntervalMs": { "type": "number", "exclusiveMinimum": 0 },
        "projectileSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "projectileDamage": { "type": "number", "exclusiveMinimum": 0 },
        "projectileRadius": { "type": "number", "exclusiveMinimum": 0 },
        "projectileLifetimeMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "attributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "uniqueItems": true
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "operation", "value"],
      "properties": {
        "attribute": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["add", "multiply"] },
        "value": { "type": "number" }
      }
    }
  }
}
