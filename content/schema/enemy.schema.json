{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content:enemy",
  "title": "敌人实例",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "templateId", "displayName", "regionId", "position"],
  "properties": {
    "id": { "$ref": "urn:content:common#/$defs/enemyId" },
    "templateId": { "$ref": "urn:content:common#/$defs/enemyTemplateId" },
    "displayName": { "$ref": "urn:content:common#/$defs/displayName" },
    "regionId": { "$ref": "urn:content:common#/$defs/regionId" },
    "position": { "$ref": "urn:content:common#/$defs/vec3" },
    "rotation": { "$ref": "urn:content:common#/$defs/vec3" },
    "tags": { "$ref": "urn:content:common#/$defs/tags" },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseAttributes": { "$ref": "urn:content:common#/$defs/attributes" }
      }
    }
  }
}
