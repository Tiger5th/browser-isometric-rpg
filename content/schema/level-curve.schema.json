{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content:level-curve",
  "title": "等级曲线",
  "description": "累计经验 → 等级的阈值表；每级属性加成走修饰器模板（与 src/logic/modifier.ts 同形）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "defaultModifiers", "levels"],
  "properties": {
    "id": { "type": "string", "pattern": "^level_curve:[a-z0-9_]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "defaultModifiers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:content:common#/$defs/modifier" }
    },
    "levels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "xpRequired"],
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "xpRequired": { "type": "integer", "minimum": 0 },
          "modifiers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "urn:content:common#/$defs/modifier" }
          }
        }
      }
    }
  }
}