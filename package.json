{
  "name": "browser-isometric-rpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:vendor": "node tools/pipeline/vendor-decoders.mjs",
    "assets:build-test": "node tools/pipeline/build-test-asset.mjs",
    "assets:build": "node tools/pipeline/build-assets.mjs",
    "assets:anime": "node tools/pipeline/build-anime-asset.mjs",
    "assets:vrm": "node tools/pipeline/vrm-to-glb.mjs",
    "assets:real-character": "node tools/pipeline/build-real-character.mjs",
    "assets:lint": "node tools/pipeline/lint.mjs",
    "assets:lint:negative": "node tools/pipeline/lint-negative-test.mjs",
    "assets:blender": "blender --background --factory-startup --python tools/pipeline/blender/export_test_asset.py -- assets/character_test_lod0.glb",
    "assets:blender:repro": "bash tools/pipeline/blender/check_reproducibility.sh",
    "assets:lod-report": "python3 tools/pipeline/compare-lod-screenshots.py",
    "content:lint": "node tools/content/lint.mjs",
    "content:lint:negative": "node tools/content/lint-negative-test.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0",
    "@babylonjs/loaders": "9.31.0",
    "@babylonjs/serializers": "9.31.0",
    "inkjs": "^2.4.0",
    "recast-navigation": "0.43.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "ajv": "8.17.1",
    "draco3d": "1.5.9",
    "meshoptimizer": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
